{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kronos AI Assistant",
  "version": "0.3.0",
  "identifier": "io.github.carlos0718.kronos",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Kronos",
        "width": 680,
        "height": 320,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Kronos AI Assistant — Configuración",
        "width": 1100,
        "height": 660,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
